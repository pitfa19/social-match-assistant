# Copy to .env.local for local development. Never commit real values.
# Production values belong in private Railway service variables, not Git.
# These are server-only. Never prefix a secret with NEXT_PUBLIC_.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
BACKEND_URL=http://localhost:8000
BACKEND_ACCESS_TOKEN=

# Production: enable auth and provide a strong private password.
APP_REQUIRE_AUTH=false
SITE_ACCESS_USER=
SITE_ACCESS_PASSWORD=

# Fictional example offers are off unless explicitly enabled.
LOCAL_DEMO_OFFERS=0
HOSTED_DEMO_OFFERS=0
